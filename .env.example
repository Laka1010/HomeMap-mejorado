VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon
VITE_VISION_PROVIDER=openai

# Opcional. Base del enlace de recuperación de contraseña que se manda por
# correo. Si no se define, se usa el origin actual (en `vite --host` sería
# http://localhost:3000, que no abre desde otro dispositivo). Para probar
# recuperación desde el móvil, pon aquí la IP LAN del ordenador que sirve la
# app y añádela tal cual en Supabase → Auth → URL Configuration → Redirect URLs.
# VITE_PUBLIC_APP_URL=http://192.168.1.42:3000
