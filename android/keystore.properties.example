# Copia este archivo como android/keystore.properties
# y rellena los valores reales antes de firmar un build de release.
# NO subas el archivo android/keystore.properties ni tu keystore al repositorio.
# En build.gradle el path se resuelve desde android/app/, por lo que ../release-keystore.jks apunta a android/release-keystore.jks

storeFile=../release-keystore.jks
storePassword=TU_PASSWORD
keyAlias=homemap-release
keyPassword=TU_PASSWORD
